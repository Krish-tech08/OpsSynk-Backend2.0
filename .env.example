# ---------- runtime ----------
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# ---------- storage & auth ----------
# firestore | memory   (memory = local only, lost on restart)
STORAGE_MODE=firestore
# firebase | dev       (dev accepts "Bearer dev:<uid>", refused when NODE_ENV=production)
AUTH_MODE=firebase
FIREBASE_PROJECT_ID=your-firebase-project-id
# Local only: path to a service-account JSON. In production prefer the platform's service identity (ADC).
GOOGLE_APPLICATION_CREDENTIALS=

# ---------- GitHub ----------
# live | fixture       (fixture = labelled demo dataset, never presented as live)
GITHUB_MODE=live
GITHUB_ORG=your-github-org
# Fine-grained token, read-only: Metadata, Contents, Issues, Pull requests, Actions, Deployments
GITHUB_TOKEN=
# Optional comma-separated repository names; empty = all repositories in GITHUB_ORG
GITHUB_REPOSITORY_ALLOWLIST=

# ---------- Gemini (optional: without a key, agents run rules-only) ----------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_CALLS_PER_MINUTE=10
MAX_MODEL_CALLS_PER_INVESTIGATION=8

# ---------- browsers ----------
# Comma-separated web-dashboard origins. Leave empty if only the Android app is used (it needs no CORS).
CORS_ORIGINS=

# ---------- limits ----------
DEMO_MODE=false
ENABLED_AGENTS=manager,github,project,bug,devops,review
MAX_INVESTIGATION_DURATION_MS=120000
AGENT_TIMEOUT_MS=45000
MAX_AGENT_TOOL_CALLS=100
INVESTIGATION_RATE_LIMIT=10
SYNC_RATE_LIMIT=5
RATE_LIMIT_WINDOW_MS=600000
# Optional JSON file overriding docs/health-scoring.md defaults
HEALTH_CONFIG_PATH=
