rules_version = '2';
// All OpsSynk data is read and written by the backend through the Admin SDK, which bypasses these rules.
// Clients (Android, web) must go through the API, so direct client access is denied entirely.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
